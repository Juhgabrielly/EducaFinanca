generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model usuarios {
  id                 Int                  @id @default(autoincrement())
  nome               String               @db.VarChar(100)
  telefone           String?              @db.VarChar(20)
  email              String               @unique(map: "email") @db.VarChar(150)
  senha              String?              @db.VarChar(255)
  tipo               TipoUsuario?         @default(USUARIO)
  plano              Plano?               @default(FREE)
  status             Boolean?             @default(true)
  criado_em          DateTime?            @default(now()) @db.DateTime(0)
  assinaturas        assinaturas[]
  investimentos      investimentos[]
  metas              metas[]
  movimentacoes      movimentacoes[]
  progresso_cursos   progresso_cursos[]
  reserva_emergencia reservas_emergencia?
  resultados_quiz    resultados_quiz[]
}

model assinaturas {
  id         Int               @id @default(autoincrement())
  usuario_id Int
  plano      Plano
  status     StatusAssinatura? @default(ATIVA)
  inicio     DateTime?         @default(now()) @db.DateTime(0)
  fim        DateTime?         @db.DateTime(0)
  usuario    usuarios          @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, map: "assinaturas_ibfk_1")

  @@index([usuario_id], map: "usuario_id")
}

model cursos {
  id               Int                @id @default(autoincrement())
  titulo           String             @db.VarChar(150)
  descricao        String?            @db.Text
  conteudo         String?            @db.Text
  exclusivo        Boolean?           @default(false)
  criado_em        DateTime?          @default(now()) @db.DateTime(0)
  progresso_cursos progresso_cursos[]
  quizzes          quizzes[]
}

model progresso_cursos {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  curso_id   Int
  progresso  Decimal? @default(0.00) @db.Decimal(5, 2)
  concluido  Boolean? @default(false)
  usuario    usuarios @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, map: "progresso_cursos_ibfk_1")
  curso      cursos   @relation(fields: [curso_id], references: [id], onUpdate: Restrict, map: "progresso_cursos_ibfk_2")

  @@unique([usuario_id, curso_id], map: "usuario_id")
  @@index([curso_id], map: "curso_id")
}

model quizzes {
  id              Int               @id @default(autoincrement())
  curso_id        Int?
  titulo          String            @db.VarChar(150)
  descricao       String?           @db.Text
  exclusivo       Boolean?          @default(false)
  questoes        questoes[]
  curso           cursos?           @relation(fields: [curso_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "quizzes_ibfk_1")
  resultados_quiz resultados_quiz[]

  @@index([curso_id], map: "curso_id")
}

model questoes {
  id               Int     @id @default(autoincrement())
  quiz_id          Int
  pergunta         String  @db.Text
  resposta_correta String  @db.VarChar(255)
  quiz             quizzes @relation(fields: [quiz_id], references: [id], onUpdate: Restrict, map: "questoes_ibfk_1")

  @@index([quiz_id], map: "quiz_id")
}

model resultados_quiz {
  id           Int       @id @default(autoincrement())
  usuario_id   Int
  quiz_id      Int
  pontuacao    Decimal   @db.Decimal(5, 2)
  realizado_em DateTime? @default(now()) @db.DateTime(0)
  usuario      usuarios  @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, map: "resultados_quiz_ibfk_1")
  quiz         quizzes   @relation(fields: [quiz_id], references: [id], onUpdate: Restrict, map: "resultados_quiz_ibfk_2")

  @@index([quiz_id], map: "quiz_id")
  @@index([usuario_id], map: "usuario_id")
}

model metas {
  id          Int       @id @default(autoincrement())
  usuario_id  Int
  nome        String    @db.VarChar(150)
  valor_meta  Decimal   @db.Decimal(12, 2)
  valor_atual Decimal?  @default(0.00) @db.Decimal(12, 2)
  criada_em   DateTime? @default(now()) @db.DateTime(0)
  usuario     usuarios  @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, map: "metas_ibfk_1")

  @@index([usuario_id], map: "usuario_id")
}

model tipos_investimento {
  id            Int             @id @default(autoincrement())
  nome          String          @db.VarChar(100)
  descricao     String?         @db.Text
  investimentos investimentos[]
}

model investimentos {
  id                   Int                @id @default(autoincrement())
  usuario_id           Int
  tipo_investimento_id Int
  nome                 String             @db.VarChar(150)
  valor_investido      Decimal            @db.Decimal(12, 2)
  valor_atual          Decimal?           @default(0.00) @db.Decimal(12, 2)
  rentabilidade        Decimal?           @default(0.00) @db.Decimal(8, 2)
  criado_em            DateTime?          @default(now()) @db.DateTime(0)
  usuario              usuarios           @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, map: "investimentos_ibfk_1")
  tipo_investimento    tipos_investimento @relation(fields: [tipo_investimento_id], references: [id], onUpdate: Restrict, map: "investimentos_ibfk_2")

  @@index([tipo_investimento_id], map: "tipo_investimento_id")
  @@index([usuario_id], map: "usuario_id")
}

model reservas_emergencia {
  id            Int       @id @default(autoincrement())
  usuario_id    Int       @unique(map: "usuario_id")
  valor         Decimal?  @default(0.00) @db.Decimal(12, 2)
  atualizado_em DateTime? @default(now()) @db.DateTime(0)
  usuario       usuarios  @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, map: "reservas_emergencia_ibfk_1")
}

model movimentacoes {
  id                Int              @id @default(autoincrement())
  usuario_id        Int
  tipo              TipoMovimentacao
  valor             Decimal          @db.Decimal(12, 2)
  descricao         String?          @db.VarChar(255)
  data_movimentacao DateTime         @db.Date
  usuario           usuarios         @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, map: "movimentacoes_ibfk_1")

  @@index([usuario_id], map: "usuario_id")
}

enum TipoUsuario {
  USUARIO
  ADMIN
}

enum Plano {
  FREE
  PREMIUM
}

enum StatusAssinatura {
  ATIVA
  EXPIRADA
  CANCELADA
}

enum TipoMovimentacao {
  RECEITA
  DESPESA
}
